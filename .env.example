# Copy to .env and fill in real values. .env is gitignored — never commit real credentials.

# MySQL staging database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=staging
MYSQL_USER=airflow
MYSQL_PASSWORD=change_me

# PostgreSQL analytics database (separate from Airflow's own metadata Postgres)
POSTGRES_ANALYTICS_HOST=postgres-analytics
POSTGRES_ANALYTICS_PORT=5432
POSTGRES_ANALYTICS_DB=analytics
POSTGRES_ANALYTICS_USER=airflow
POSTGRES_ANALYTICS_PASSWORD=change_me

# Docker Compose / Airflow
AIRFLOW_UID=50000
